# 环境变量(含密钥)
.env

# 依赖与构建产物
node_modules/
web/.next/
web/out/

# v2 部署产物(本地构建中间物)
web/_deploy/
web/deploy.tgz

# v2 运行时数据(SQLite 与上传文件不进 git,migrations 进)
web/db/*.db
web/db/*.db-shm
web/db/*.db-wal
web/data/
web/uploads/

# 杂项
*.test.js
.trae/
.superpowers/
docs/superpowers/

# 本机异地备份副本(pull-backup.sh 拉取)
_backups/

# 本地 dev 后台凭据（桌面发布台用），不进 git
scripts/dev-admin.env
