# 精简部署镜像:封装已构建好的 standalone(不跑 next build),
# 容器内装 Linux 版 better-sqlite3(容器 glibc 2.36 + Debian gcc,绕开宿主老 glibc)。
# 国内网络优化:apt 走阿里云镜像,npm 走 npmmirror,预编译下不到则源码编译(有 gcc 兜底)。
# 用 node:22-slim:better-sqlite3@13 要求 Node 22 ABI(宿主是 Node20,容器隔离不受影响)。
FROM node:22-slim

# apt 换阿里云镜像(本机是阿里云,内网极快),装编译工具作为 better-sqlite3 源码编译兜底
RUN set -eux; \
    if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
      sed -i 's|deb.debian.org|mirrors.aliyun.com|g; s|security.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources; \
    else \
      sed -i 's|deb.debian.org|mirrors.aliyun.com|g; s|security.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list; \
    fi; \
    apt-get update && apt-get install -y --no-install-recommends python3 make g++ ca-certificates && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY standalone/ ./
COPY static/ ./.next/static
COPY public/ ./public
COPY db/migrations ./db/migrations
COPY db/bootstrap.js ./db/bootstrap.js
COPY db/seed/seed.js ./db/seed/seed.js

# npm 走国内镜像;better-sqlite3 预编译走 npmmirror 二进制镜像,下不到则 gcc 源码编译
RUN npm config set registry https://registry.npmmirror.com \
 && npm_config_better_sqlite3_binary_host_mirror=https://registry.npmmirror.com/-/binary/better-sqlite3 \
    npm install better-sqlite3@13.0.1 --no-save --no-audit --no-fund \
 && node -e "const D=require('better-sqlite3');new D(':memory:').exec('create table t(x)');console.log('better-sqlite3 OK in image')"

ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0 NEXT_TELEMETRY_DISABLED=1
EXPOSE 3000
CMD ["node", "server.js"]
